{
  "name": "@chunky-fm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "sync-check": "tsx scripts/sync-check.ts",
    "//check:r2": "Is the object storage actually usable? Answers the four questions that account for essentially every R2 misconfiguration, the important one being whether the API token can *write* — a read-only token passes every connection check and then fails the first upload.",
    "check:r2": "tsx --env-file-if-exists=.env scripts/check-r2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.12.1",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.15.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

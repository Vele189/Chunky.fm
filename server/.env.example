# Copy to .env — `npm run dev` and `npm start` load it if it exists. On Railway
# there is no .env; set these as service variables instead.

# Optional. Leave it empty and the decks fall back to the same code the door
# uses — see STATION_KEY below, and `houseKey` in server/src/config.ts. One code
# then opens both, which is the point of the default and is fine for a room of
# friends.
#
# It costs what it sounds like: anybody you give the code to so they can listen
# can also upload, drive the decks and end the broadcast. Set this to give the
# admin panel a password of its own — which anything reachable from the internet
# should do — and the two come apart with no other change. It also signs the
# admin session cookie, so changing it signs everyone out.
ADMIN_PASSWORD=

# Optional. The station has a door on it by default, with a code baked into the
# server — see `houseKey` in server/src/config.ts, which explains how to read it
# back. Set this to replace that code with one you chose, which is what any
# station with real people in it should do.
#
# It is the same secret whether it is typed at the door or carried by a link:
#
#     https://<your-station>/?k=$STATION_KEY
#
# The browser presents it once and keeps a signed cookie for a month, so the
# link is needed once per device — and somebody who was told the code instead
# can type it on the refused screen. Rotating this locks every device out at the
# same moment, which is how you un-invite somebody.
#
# Generate one with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
#
# If you forget which code is in force: sign in to the console and press Share.
# Admin credentials satisfy the listener gate too, so whoever holds
# ADMIN_PASSWORD can always get in and read it back.
STATION_KEY=

# Optional. Takes the door off entirely — anyone with the address can listen.
# Only the exact string `true` does it, and an explicit STATION_KEY still wins,
# so a half-set variable can never be the thing that publishes your station.
# Off by default: an unset STATION_KEY used to mean an open station, and now
# means the baked-in code, because a station that quietly became public during a
# deploy is a worse surprise than one that quietly asks for a password.
STATION_OPEN=

# Railway volume mount point. Audio, artwork and the SQLite file all live here.
AUDIO_STORAGE_DIR=./audio_storage

# Where the built client is, when this process is also the thing serving it.
#
# Leave it unset here. In development Vite serves the client and proxies /api
# and /ws through to this server, and under docker compose nginx does the same
# job — in both, something else owns `/` and a server that started answering it
# too would make the two deployments diverge.
#
# The single image sets it (to /app/client, see the root Dockerfile), which is
# what lets Railway run the whole station as one container with no nginx. See
# "Deploying" in the README.
# CLIENT_DIR=

# Optional overrides.
# DB_PATH=./audio_storage/chunky.sqlite
# HOST=0.0.0.0
# PORT=3000
# MAX_UPLOAD_BYTES=157286400

# Where the station asks about lyrics. LRCLIB is public and keyless, so this is
# an address rather than a credential — point it at a mirror if the public one
# is ever unreachable from where the station runs.
# LRCLIB_BASE_URL=https://lrclib.net

# Who may tell the station where a request really came from. Default true:
# nothing reaches this directly in either deployment — nginx is in front of it
# under compose, the platform edge is in production — so `X-Forwarded-For` is
# how the sign-in throttle tells one caller from another. Keyed on the proxy
# instead, every caller shares one bucket and a stranger can lock the admin out.
# Set false when nothing is in front, or give a hop count or a list of proxy
# addresses. Trusting it means not publishing the origin port to the internet.
# TRUST_PROXY=true

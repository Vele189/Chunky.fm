# Copy to .env. `npm run dev` and `npm start` load it if it exists. On Railway
# there is no .env; set these as service variables instead.

# Optional. Leave it empty and the decks fall back to a code baked into the
# server; see `houseKey` in server/src/config.ts, which explains how to read it
# back. This is the one thing an unconfigured station does guard: listening is
# open, driving is not.
#
# Set this to give the decks a password you chose, which anything reachable from
# the internet should do. It also signs the admin session cookie, so changing it
# signs everyone out.
ADMIN_PASSWORD=

# Optional, and empty is the ordinary case: with no key set, anybody with the
# address can listen and nobody is asked for anything on the way in.
#
# Set this to put a door on. Everything below is what happens when you do, and
# none of it was removed to make the station open, only switched off:
#
#     https://<your-station>/?k=$STATION_KEY
#
# It is the same secret typed at the door or carried by a link. The browser
# presents it once and keeps a signed cookie for a month, so the link is needed
# once per device, and somebody who was told the code instead can type it on the
# refused screen. Rotating this locks every device out at the same moment, which
# is how you un-invite somebody.
#
# Generate one with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
#
# If you forget which code is in force: sign in to the console and press Share.
# Admin credentials satisfy the listener gate too, so whoever holds
# ADMIN_PASSWORD can always get in and read it back.
STATION_KEY=

# Obsolete, and harmless. Taking the door off used to need this; an open station
# is now the default, so it says nothing. Kept accepted rather than an error so
# a file that has been carrying it keeps meaning what it always meant. An
# explicit STATION_KEY still wins.
STATION_OPEN=

# Railway volume mount point. Audio, artwork and the SQLite file all live here.
AUDIO_STORAGE_DIR=./audio_storage

# Where the built client is, when this process is also the thing serving it.
#
# Leave it unset here. In development Vite serves the client and proxies /api
# and /ws through to this server, and under docker compose nginx does the same
# job: in both, something else owns `/` and a server that started answering it
# too would make the two deployments diverge.
#
# The single image sets it (to /app/client, see the root Dockerfile), which is
# what lets Railway run the whole station as one container with no nginx. See
# "Deploying" in the README.
# CLIENT_DIR=

# Optional overrides.
# DB_PATH=./audio_storage/chunky.sqlite
# HOST=0.0.0.0
# PORT=3000
# MAX_UPLOAD_BYTES=157286400

# Where the station asks about lyrics. LRCLIB is public and keyless, so this is
# an address rather than a credential, so point it at a mirror if the public one
# is ever unreachable from where the station runs.
# LRCLIB_BASE_URL=https://lrclib.net

# Who may tell the station where a request really came from. Default true:
# nothing reaches this directly in either deployment: nginx is in front of it
# under compose, the platform edge is in production, so `X-Forwarded-For` is
# how the sign-in throttle tells one caller from another. Keyed on the proxy
# instead, every caller shares one bucket and a stranger can lock the admin out.
# Set false when nothing is in front, or give a hop count or a list of proxy
# addresses. Trusting it means not publishing the origin port to the internet.
# TRUST_PROXY=true


# --- the podcast archive: Cloudflare R2 ---------------------------------------
#
# All five together, or none of them. Unset, the archive lives on the storage
# volume and the same chunked upload runs against this server instead — which is
# what `docker compose` and `npm run dev` do, and is a supported way to run this
# rather than a degraded one.
#
# With them set, a gigabyte of master goes from the browser straight to
# Cloudflare and never touches this container, and viewers fetch the video from
# the CDN rather than from here.
#
# The CORS policy below is for the *upload* only. Playback needs none: the
# player points a <video> element at the CDN and nothing reads its pixels or its
# samples back, so the browser never asks the bucket's permission to fetch it.
#
# The bucket needs CORS for the direct upload. In the R2 dashboard, under the
# bucket's Settings -> CORS policy:
#
#   [{ "AllowedOrigins": ["https://your-station.example"],
#      "AllowedMethods": ["PUT"],
#      "AllowedHeaders": ["content-type"],
#      "ExposeHeaders": ["ETag"],
#      "MaxAgeSeconds": 3600 }]
#
# ExposeHeaders is the one that is easy to miss and fails confusingly: without
# it the browser uploads every part successfully and cannot read the receipt.
#
# Set a lifecycle rule on the bucket too, under Settings -> Object lifecycle
# rules: **abort incomplete multipart uploads after 1 day**. A browser closed
# in the middle of a two-gigabyte upload leaves its finished parts in the
# bucket, and R2 bills for them until something removes them. The console
# aborts an upload it knows it has lost; the rule is for the ones nobody was
# left to tell it about.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://media.your-station.example
#
# For another S3-compatible provider, or for the MinIO the tests run against:
# R2_ENDPOINT=

# The most an episode's master may weigh. Checked when an upload is begun,
# from a size the client states, because the bytes never come through here.
# Five gigabytes by default: an hour of 1080p at 8 Mbps is 3.6 GB.
# MAX_EPISODE_BYTES=5368709120

node_modules/

# build output
dist/
build/
.vite/

# secrets — admin password lives here
.env
.env.*
!.env.example

# Railway volume mount: uploaded audio + artwork + sqlite.
# Never commit the music library.
#
# `data/` is anchored to the root on purpose: unanchored it matches a directory
# called data anywhere in the tree, and the landing page keeps one — its country
# outlines live at client/src/landing/data/, and the bare rule silently kept
# them out of every checkout but this one. Green here, red in CI. The other two
# stay unanchored: an audio library is the library wherever it lands, and the
# dev server grows one under server/.
/data/
uploads/
audio_storage/

# sqlite
*.sqlite
*.sqlite3
*.db
*-wal
*-shm

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# editors / os
.DS_Store
.idea/
.vscode/
*.swp

# client build output
client/dist/

# The hero model as it came off Sketchfab: 30 MB, 25 PNG textures. What ships is
# the 1 MB `client/src/assets/models/gramophone.glb` built from it, which is
# committed. Only `npm run assets:models` needs this file, and only when the
# model itself changes — see the README.
client/assets-src/gramophone.glb
